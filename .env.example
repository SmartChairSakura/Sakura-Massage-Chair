# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://ndhlvkqswysexrdurlrk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Backoffice Session & Security Configuration
JWT_SECRET=generate-a-32-byte-random-secret-here
# Server-driven price per pulse (IDR): default 1 for demo (Rp 5 - 40), set 1000 for production (Rp 5.000 - 40.000 without ESP32 re-flash)
PRICE_PER_PULSE_IDR=1
MIN_PRICE_PER_PULSE_IDR=1
# Optional device & cron authentication secrets (leave empty during ESP32 demo transition)
IOT_DEVICE_SECRET=
CRON_SECRET=

# Midtrans Configuration
MIDTRANS_SERVER_KEY=Mid-server-your-server-key-here
MIDTRANS_CLIENT_KEY=Mid-client-your-client-key-here
MIDTRANS_MERCHANT_ID=your-merchant-id-here
MIDTRANS_IS_PRODUCTION=false

# Base App URL
NEXT_PUBLIC_APP_URL=https://sakura-massage-chair.vercel.app

# Gmail SMTP Configuration for Admin OTP & Notifications
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-google-app-password
